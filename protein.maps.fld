# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by autogrid4.
#
#SPACING 0.375
#NELEMENTS 60 60 60
#CENTER 10.261 -3.492 -0.127
#MACROMOLECULE 
#GRID_PARAMETER_FILE grid.gpf
#
ndim=3			# number of dimensions in the field
dim1=61			# number of x-elements
dim2=61			# number of y-elements
dim3=61			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=14		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=protein.maps.xyz filetype=ascii offset=0
coord 2 file=protein.maps.xyz filetype=ascii offset=2
coord 3 file=protein.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=F-affinity	# component label for variable 3
label=NA-affinity	# component label for variable 4
label=OA-affinity	# component label for variable 5
label=N-affinity	# component label for variable 6
label=HD-affinity	# component label for variable 7
label=Br-affinity	# component label for variable 8
label=Cl-affinity	# component label for variable 9
label=I-affinity	# component label for variable 10
label=S-affinity	# component label for variable 11
label=P-affinity	# component label for variable 12
label=Electrostatics	# component label for variable 12
label=Desolvation	# component label for variable 13
#
# location of affinity grid files and how to read them
#
variable 1 file=protein.A.map filetype=ascii skip=6
variable 2 file=protein.C.map filetype=ascii skip=6
variable 3 file=protein.F.map filetype=ascii skip=6
variable 4 file=protein.NA.map filetype=ascii skip=6
variable 5 file=protein.OA.map filetype=ascii skip=6
variable 6 file=protein.N.map filetype=ascii skip=6
variable 7 file=protein.HD.map filetype=ascii skip=6
variable 8 file=protein.Br.map filetype=ascii skip=6
variable 9 file=protein.Cl.map filetype=ascii skip=6
variable 10 file=protein.I.map filetype=ascii skip=6
variable 11 file=protein.S.map filetype=ascii skip=6
variable 12 file=protein.P.map filetype=ascii skip=6
variable 13 file=protein.e.map filetype=ascii skip=6
variable 14 file=protein.d.map filetype=ascii skip=6
